# Operator arguments for the Whorld kiosk (deploy/whorld-kiosk.service).
#
# deploy/install.sh copies this file to /etc/default/whorld on first install
# and never overwrites it afterwards. It is read on every start/restart, so
# after editing run:  sudo systemctl restart whorld-kiosk
#
# PREFERRED: put your show settings in the show config file
#       /usr/local/share/whorld/whorld.conf
# and enable it with a single line here:
#   WHORLD_ARGS=--config /usr/local/share/whorld/whorld.conf
# deploy/whorld.conf documents every key (patch, playlist, renderer, warp,
# MIDI/OSC/audio options, ...). Values are defaults; flags in WHORLD_ARGS or on
# the ExecStart line still override them. `whorld --config-save /tmp/show.conf`
# writes a working command line back out in that format.
#
# Alternatively, WHORLD_ARGS is appended verbatim to the unit's ExecStart
# command line, so every flag from `whorld --help` works here. Keep it to a
# single space-separated list; there is no need to quote values that contain no
# spaces. Leave it empty (the default) for the stock fullscreen demo.
#
# Examples (uncomment the one you want):
#
#   # Recommended: read the show config file (edit it, not this line)
#   WHORLD_ARGS=--config /usr/local/share/whorld/whorld.conf
#
#   # USB MIDI controller (see `whorld --list-midi` for the address)
#   WHORLD_ARGS=--midi-source 24:0
#
#   # High-resolution or relative-encoder controller
#   WHORLD_ARGS=--midi-source "nanoKONTROL2:0" --midi-mode 14bit --midi-takeover
#
#   # Light up a controller's LEDs / motor faders
#   WHORLD_ARGS=--midi-source 24:0 --midi-out --midi-feedback
#
#   # OSC control surface on the LAN / from a phone
#   WHORLD_ARGS=--osc-port 9000
#
#   # Projection mapping: warp the frame onto the projector quad
#   WHORLD_ARGS=--warp "0.06,0.04,0.95,0.10,0.90,0.96,0.10,0.88"
#   # ... or read the corners from a file
#   WHORLD_ARGS=--warp-file /usr/local/share/whorld/warp.txt
#
#   # Start a specific show instead of the demo patch
#   WHORLD_ARGS=--patch /usr/local/share/whorld/demo.whp --playlist /usr/local/share/whorld/demo.whl
#
#   # Audio-reactive with a different ALSA device
#   WHORLD_ARGS=--audio --audio-device hw:1,0 --audio-gain 1.5
#
#   # Pin the renderer / render scale on a slow GPU
#   WHORLD_ARGS=--renderer gpu --scale 0.75
#
# Debug helper: render one PNG offscreen and exit (does not touch the
# console). Uses the GPU backend through the offscreen SDL driver:
#   WHORLD_ARGS=--video-driver offscreen --renderer gpu --render /tmp/whorld-check.png --frames 120
WHORLD_ARGS=
